<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+. Nothing goes to cloud backup. Moving to a new phone (device-to-device
  transfer) takes the WebView's storage, where IndexedDB keeps presets and the log;
  the session journal (files/) and everything else stay behind.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
